{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue depth (requests waiting)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "aibox:requests_waiting", "legendFormat": "{{model}}"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "KV-cache usage",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "aibox:kv_cache_usage_ratio", "legendFormat": "{{model}}"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Running batch",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "aibox:requests_running", "legendFormat": "{{model}}"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Prefix-cache hit rate (runtime-native)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "vllm:gpu_prefix_cache_hit_rate", "legendFormat": "{{model_name}}"},
        {"refId": "B", "expr": "sglang:cache_hit_rate", "legendFormat": "{{model_name}}"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["aibox", "capacity"],
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "AIBox — Capacity",
  "uid": "aibox-capacity",
  "version": 1
}
