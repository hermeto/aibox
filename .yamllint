extends: default
ignore: |
  bin/
  node_modules/
  .specify/
  **/.terraform/
  internal/profile/testdata/invalid/not-yaml.yaml
  # Helm templates are Go templates, validated by `make validate-manifests` instead.
  platform/**/templates/
rules:
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  line-length: disable
  document-start: disable
  truthy:
    allowed-values: ["true", "false", "on"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  indentation:
    spaces: 2
    indent-sequences: consistent
