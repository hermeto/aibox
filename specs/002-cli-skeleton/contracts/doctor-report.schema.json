{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hermeto/aibox/specs/002-cli-skeleton/contracts/doctor-report.schema.json",
  "title": "aibox doctor report",
  "type": "object",
  "required": ["profile", "provider", "checks", "summary", "ok"],
  "additionalProperties": false,
  "properties": {
    "profile": { "type": "string" },
    "provider": { "enum": ["kind", "aws"] },
    "ok": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": ["pass", "warn", "fail", "skip"],
      "additionalProperties": false,
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "skip": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "message"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "enum": ["pass", "warn", "fail", "skip"] },
          "message": { "type": "string" },
          "remediation": { "type": "string" },
          "details": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    }
  }
}
